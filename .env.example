# Copy to web/.env and adjust if needed (never commit .env).
# Vite only exposes variables prefixed with VITE_ to the browser.

# Base URL of the OrderWise server.
# Local dev: http://localhost:3001
# Production: your deployed Render URL, e.g. https://orderwise-server.onrender.com
VITE_API_URL=http://localhost:3001
